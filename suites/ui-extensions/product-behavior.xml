<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Opt-in guest read-only Phase 2; never discovered by standard or Phase 1 suites. -->
<suite name="Baku Electronics Guest UI Extension Phase 2" parallel="none">
    <listeners>
        <listener class-name="az.bakuelectronics.automation.support.RetryAnnotationTransformer"/>
        <listener class-name="az.bakuelectronics.automation.support.AllureTestNgGroupLabelListener"/>
    </listeners>
    <test name="Phase 2 guest read-only extension">
        <groups><run><include name="read-only"/><exclude name="manual-auth"/><exclude name="sensitive-auth"/></run></groups>
        <classes>
            <class name="az.bakuelectronics.automation.ui.SearchQueryNormalizationTest"/>
            <class name="az.bakuelectronics.automation.ui.ClearAllFiltersTest"/>
            <class name="az.bakuelectronics.automation.ui.OutOfStockPurchaseRestrictionTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductReviewSectionTest"/>
        </classes>
    </test>
</suite>
