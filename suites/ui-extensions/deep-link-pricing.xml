<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Baku Electronics Guest UI Extension Phase 5" parallel="none" thread-count="1">
    <listeners>
        <listener class-name="az.bakuelectronics.automation.support.RetryAnnotationTransformer"/>
        <listener class-name="az.bakuelectronics.automation.support.AllureTestNgGroupLabelListener"/>
    </listeners>
    <test name="Phase 5 verified read-only guest tests">
        <groups><run><include name="read-only"/><exclude name="manual-auth"/><exclude name="sensitive-auth"/></run></groups>
        <classes>
            <class name="az.bakuelectronics.automation.ui.CategoryFilterDeepLinkStateTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductCardDetailPriceParityTest"/>
        </classes>
    </test>
</suite>
