<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Diagnostic selection only. Assertions, fail-closed guest guard and cleanup remain authoritative. -->
<suite name="Baku Electronics API Known Issues Diagnostic Suite" parallel="none">
    <listeners>
        <listener class-name="az.bakuelectronics.automation.support.RetryAnnotationTransformer"/>
        <listener class-name="az.bakuelectronics.automation.support.AllureTestNgGroupLabelListener"/>
    </listeners>
    <test name="Known API Contract and Safety Issues"><classes>
        <class name="az.bakuelectronics.automation.api.BasketPostZeroQuantityTest"/>
        <class name="az.bakuelectronics.automation.api.BasketUnauthorizedRequestTest"/>
    </classes></test>
</suite>
