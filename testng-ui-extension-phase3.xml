<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Opt-in Phase 3 only. Accessibility defects intentionally retain failing assertions. -->
<suite name="Baku Electronics Guest UI Extension Phase 3" parallel="none">
    <listeners>
        <listener class-name="az.bakuelectronics.automation.support.RetryAnnotationTransformer"/>
        <listener class-name="az.bakuelectronics.automation.support.AllureTestNgGroupLabelListener"/>
    </listeners>
    <test name="Phase 3 verified guest read-only journeys">
        <groups><run><include name="read-only"/><exclude name="manual-auth"/><exclude name="sensitive-auth"/></run></groups>
        <classes>
            <class name="az.bakuelectronics.automation.ui.InstallmentOptionsConsistencyTest"/>
            <class name="az.bakuelectronics.automation.ui.RelatedProductsNavigationTest"/>
            <class name="az.bakuelectronics.automation.ui.MobileResponsiveNavigationTest"/>
            <class name="az.bakuelectronics.automation.ui.KeyboardAccessibilityNavigationTest"/>
        </classes>
    </test>
</suite>
