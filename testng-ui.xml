<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Baku Electronics UI Suite" parallel="none">
    <listeners>
        <listener class-name="az.bakuelectronics.automation.support.RetryAnnotationTransformer"/>
        <listener class-name="az.bakuelectronics.automation.support.AllureTestNgGroupLabelListener"/>
    </listeners>
    <test name="UI Tests">
        <groups><run><exclude name="manual-auth"/><exclude name="sensitive-auth"/></run></groups>
        <classes>
            <class name="az.bakuelectronics.automation.ui.AccountLoginTest"/>
            <class name="az.bakuelectronics.automation.ui.CartContentsTest"/>
            <class name="az.bakuelectronics.automation.ui.CartProductAdditionTest"/>
            <class name="az.bakuelectronics.automation.ui.CartProductRemovalTest"/>
            <class name="az.bakuelectronics.automation.ui.CartQuantityDecreaseTest"/>
            <class name="az.bakuelectronics.automation.ui.CartQuantityIncreaseTest"/>
            <class name="az.bakuelectronics.automation.ui.CartQuantityPriceValidationTest"/>
            <class name="az.bakuelectronics.automation.ui.CartZeroQuantityRemovalTest"/>
            <class name="az.bakuelectronics.automation.ui.CategoryNavigationTest"/>
            <class name="az.bakuelectronics.automation.ui.CategoryPaginationTest"/>
            <class name="az.bakuelectronics.automation.ui.HomePageLoadTest"/>
            <class name="az.bakuelectronics.automation.ui.LoginFormNavigationTest"/>
            <class name="az.bakuelectronics.automation.ui.LoginInputRejectionTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductBrandFilterTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductDetailsValidationTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductPriceFilterTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductPriceSortingTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductSearchEmptyResultsTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductSearchNavigationTest"/>
            <class name="az.bakuelectronics.automation.ui.ProductSearchResultsTest"/>
        </classes>
    </test>
</suite>
