<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Baku Electronics Full Regression Suite">
    <listeners>
        <listener class-name="az.bakuelectronics.automation.support.RetryAnnotationTransformer"/>
        <listener class-name="az.bakuelectronics.automation.support.AllureTestNgGroupLabelListener"/>
    </listeners>
    <test name="Offline Unit Tests"><classes>
        <class name="az.bakuelectronics.automation.support.RetryPolicyTest"/>
        <class name="az.bakuelectronics.automation.support.RetryAttachmentTest"/>
        <class name="az.bakuelectronics.automation.support.SensitiveReportingTest"/>
        <class name="az.bakuelectronics.automation.support.AuthenticatedUiApprovalTest"/>
        <class name="az.bakuelectronics.automation.unit.PriceParsingArithmeticTest"/>
        <class name="az.bakuelectronics.automation.unit.CartPageQuantityTest"/>
        <class name="az.bakuelectronics.automation.unit.CartPageVisibilityTest"/>
        <class name="az.bakuelectronics.automation.unit.CartPageNavigationTest"/>
        <class name="az.bakuelectronics.automation.unit.GuestCartCleanupTest"/>
        <class name="az.bakuelectronics.automation.unit.CartPagePriceSummaryTest"/>
        <class name="az.bakuelectronics.automation.unit.LoginRejectionVerificationTest"/>
        <class name="az.bakuelectronics.automation.support.LoginDiagnosticInputTest"/>
        <class name="az.bakuelectronics.automation.api.ApiClientAuthenticationTest"/>
        <class name="az.bakuelectronics.automation.unit.api.BasketSnapshotContractTest"/>
        <class name="az.bakuelectronics.automation.unit.api.BasketStateRestorationTest"/>
        <class name="az.bakuelectronics.automation.unit.api.ProductIdentityMatchingTest"/>
        <class name="az.bakuelectronics.automation.support.api.ApiResultReportingTest"/>
        <class name="az.bakuelectronics.automation.api.InvalidSlugDiagnosticSafetyTest"/>
        <class name="az.bakuelectronics.automation.api.InvalidProductSlugSafetyTest"/>
        <class name="az.bakuelectronics.automation.support.JsonArrayLoadingTest"/>
        <class name="az.bakuelectronics.automation.support.WaitConditionResultTest"/>
    </classes></test>
    <test name="Public Read-only API Tests"><classes>
        <class name="az.bakuelectronics.automation.api.DefaultSearchAvailabilityTest"/>
        <class name="az.bakuelectronics.automation.api.DefaultSearchResultContractTest"/>
    </classes></test>
    <test name="Authenticated Read-only API Tests"><classes>
        <class name="az.bakuelectronics.automation.api.BasketSnapshotReadTest"/>
        <class name="az.bakuelectronics.automation.api.BasketUnauthorizedRequestTest"/>
        <class name="az.bakuelectronics.automation.api.AuthenticationFlowTest"/>
    </classes></test>
    <test name="API Mutation Tests"><classes>
        <class name="az.bakuelectronics.automation.api.BasketProductAdditionTest"/>
        <class name="az.bakuelectronics.automation.api.BasketQuantityUpdateTest"/>
        <class name="az.bakuelectronics.automation.api.BasketZeroQuantityRemovalTest"/>
        <class name="az.bakuelectronics.automation.api.BasketProductRemovalTest"/>
        <class name="az.bakuelectronics.automation.api.BasketResponseFieldsTest"/>
        <class name="az.bakuelectronics.automation.api.BasketInvalidSlugResponseTest"/>
        <class name="az.bakuelectronics.automation.api.BasketPostZeroQuantityTest"/>
    </classes></test>
    <test name="API/UI Integration Tests"><classes>
        <class name="az.bakuelectronics.automation.integration.ProductApiUiConsistencyTest"/>
        <class name="az.bakuelectronics.automation.integration.BasketApiUiVisibilityTest"/>
    </classes></test>
    <test name="UI Tests">
        <groups><run><exclude name="manual-auth"/><exclude name="sensitive-auth"/></run></groups>
        <packages><package name="az.bakuelectronics.automation.ui"/></packages>
    </test>
</suite>
